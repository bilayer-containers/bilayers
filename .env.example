# Optional environment variables for local development.
# Copy to .env and uncomment/edit as needed - scripts fall back to sensible
# defaults when these are unset.

# Overrides the path to the bilayers_algorithms package used by
# scripts/validate.sh, instead of the installed package.
# ALGORITHMS_PATH=

# Overrides the Buildx builder used by noxfile.py's Docker build sessions,
# instead of whatever builder is currently active.
# DOCKER_BUILDER=
